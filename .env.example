# Kehrkraft configuration

# Listening port; when unset, binds to an OS-assigned ephemeral port (>1024).
PORT=3000

# SQLite database URL (tests use sqlite::memory:).
DATABASE_URL=sqlite:kehrkraft.db

# Admin Basic Auth credentials (both are required, unless KEHRKRAFT_DEMO_MODE=true).
ADMIN_USER=admin
ADMIN_PASS=change-me

# Demo mode: set to true (or 1/yes/on) to disable admin authentication and
# show a "Demo Mode" banner on every page.
# KEHRKRAFT_DEMO_MODE=true

# Optional tracing/logging filter, e.g. debug, warn.
RUST_LOG=info
