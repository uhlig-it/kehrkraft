# Kehrkraft configuration

# Listening port; when unset, binds to an OS-assigned ephemeral port (>1024).
PORT=3000

# SQLite database URL (tests use sqlite::memory:).
DATABASE_URL=sqlite:kehrkraft.db

# Admin Basic Auth credentials (both are required).
ADMIN_USER=admin
ADMIN_PASS=change-me

# Optional tracing/logging filter, e.g. debug, warn.
RUST_LOG=info